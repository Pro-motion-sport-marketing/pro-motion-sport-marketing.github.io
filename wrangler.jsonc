{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promotionec",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "promotionec.com", "custom_domain": true },
    { "pattern": "www.promotionec.com", "custom_domain": true }
  ]
}
